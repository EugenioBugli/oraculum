# Virtual display + VNC/noVNC for circus on the Jetson (no Xvfb on the host, no sudo). Run with --network host: circus on
# the host then reaches the X server through its abstract socket (@/tmp/.X11-unix/X<n>), shared by the host netns.
# ffmpeg: clip of every run (measure_rtf.sh records the virtual screen with x11grab).
FROM ubuntu:22.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends xvfb x11vnc novnc websockify ffmpeg \
    && rm -rf /var/lib/apt/lists/*
